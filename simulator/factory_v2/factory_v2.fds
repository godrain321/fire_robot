&HEAD CHID='factory_v2', TITLE='SLAM-derived factory geometry baseline' /

! 27.15 m x 22.65 m source map, padded only at +X/+Y to 0.2 m cells.
&MESH IJK=136,114,15, XB=0.0,27.2,0.0,22.8,0.0,3.0 /

! Machinery-adjacent oil fire scenario; local ignition reaches full HRRPUA at 5 s.
&TIME T_END=0 /

! Retained from factory_v1 for the configured propane fire and CO output.
&REAC FUEL='PROPANE', SOOT_YIELD=0.01, CO_YIELD=0.02,
      HEAT_OF_COMBUSTION=46460. /

&SURF ID='SLAM_WALL', COLOR='GRAY 30' /
&SURF ID='UNMAPPED_SOLID', COLOR='GRAY 70' /
&SURF ID='NO_GO_WALL', COLOR='ORANGE' /
&SURF ID='MACHINERY', COLOR='DARK GRAY' /
&SURF ID='EXIT_SOLID', COLOR='BLUE' /

! CATF keeps generated geometry separate from hand-maintained FDS settings.
&CATF OTHER_FILES='generated/obstacles.inc','generated/exits.inc',
      'generated/scenario.inc' /

! Output definitions mirror factory_v1 for later sensor-data integration.
&DUMP DT_SLCF=1.0, DT_SL3D=1.0 /
&SLCF ID='TEMP_3D', XB=0.0,27.2,0.0,22.8,0.0,3.0,
      QUANTITY='TEMPERATURE', CELL_CENTERED=T /
&SLCF ID='CO_Z130', PBZ=1.3, QUANTITY='VOLUME FRACTION',
      SPEC_ID='CARBON MONOXIDE', CELL_CENTERED=T /

&TAIL /
